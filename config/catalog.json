      "id": "fast_startup_disable",
      "group": "CUIDADO",
      "winverMin": 22000,
      "title": "Desativar Inicialização Rápida",
      "description": "Desativa Fast Startup (pode afetar dual-boot)",
      "impact": "Médio - Afeta dual-boot e alguns cenários",
      "reversible": true,
      "revertMethod": "registry",
      "requiresAdmin": true,
      "dangerous": true,
      "transactionCritical": true,
      "tags": ["system", "boot"],
      "backupKeys": [
        "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Power"
      ],
      "notes": ["Em dual-boot pode impedir acesso a outras partições", "Requer reinicialização"],
      "actions": [
        {"type": "reg_set", "hive": "HKLM", "path": "SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Power", "name": "HiberbootEnabled", "value": 0, "type": "DWord"}
      ]
    },
