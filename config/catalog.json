    {
      "id": "tips_suggestions",
      "group": "SEGURO",
      "winverMin": 22000,
      "title": "Dicas, truques e sugestões",
      "description": "Desativa dicas e sugestões do Windows",
      "impact": "Muito baixo",
      "reversible": true,
      "revertMethod": "registry",
      "requiresAdmin": true,
      "dangerous": false,
      "transactionCritical": false,
      "tags": ["telemetry", "tips"],
      "backupKeys": [
        "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager"
      ],
      "notes": ["Reversível via registro"],
      "actions": [
        {"type": "reg_set", "hive": "HKCU", "path": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-338388Enabled", "value": 0, "type": "DWord"},
        {"type": "reg_set", "hive": "HKCU", "path": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-310093Enabled", "value": 0, "type": "DWord"},
        {"type": "reg_set", "hive": "HKCU", "path": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SoftLandingEnabled", "value": 0, "type": "DWord"}
      ]
    },
    {
